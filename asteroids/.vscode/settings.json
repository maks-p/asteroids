{
  // Turns off the suggestion popup as you type (IntelliSense)
  "editor.quickSuggestions": {
    "other": "off",
    "comments": "off",
    "strings": "off"
  },
  "editor.suggestOnTriggerCharacters": false,
  "editor.wordBasedSuggestions": "off",
  "editor.parameterHints.enabled": false,

  // Turns off the gray ghost-text completions (Copilot and other AI tools)
  "editor.inlineSuggest.enabled": false,
  "github.copilot.enable": { "*": false },

  // Ruff's formatter does not sort imports; that is a lint fix (rule I001),
  // so it has to run as a code action on save, alongside formatting.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  }
}
